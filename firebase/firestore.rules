rules_version = '2';

// Phase 0 v0 rules (Plan §3). Trust model: any authenticated member of a
// room may read/write shared table-state documents. The one hard boundary
// is `gmPrivate/**`, which only the room's GM UID may ever read or write —
// that is the sole mechanism that makes hidden GM information hidden.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomDoc(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId));
    }

    function isGM(roomId) {
      return signedIn() && roomDoc(roomId).data.gmUid == request.auth.uid;
    }

    function isMember(roomId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid));
    }

    // Per-user "My Rooms" convenience index (Master Plan v2, R6.2). A user may
    // only ever read or write their OWN index — never peek at or tamper with
    // anyone else's list of rooms. Best-effort data: it grants no authority
    // (every real access check reads the room doc's `gmUid`/`players` subtree,
    // never this index).
    match /users/{userId}/rooms/{roomId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /rooms/{roomId} {
      // Room creation: the creator becomes GM (gmUid must equal their own uid)
      // AND must have signed in with a NON-ANONYMOUS provider (R24.1).
      //
      // Without the provider check, any browser that loads the app mints a
      // fresh anonymous uid and can create unlimited rooms — free, and with no
      // attribution. On Spark, quota exhaustion denies requests rather than
      // billing, so the realistic failure is an outage for the whole group.
      // Requiring a real provider turns "any browser" into "any Google
      // account", which is what makes every downstream containment measure
      // meaningful: an abusive creator is identifiable and blockable in the
      // console.
      //
      // Deliberately scoped to `create` ONLY. Two consequences that are
      // features, not oversights:
      //  - The JOIN path is untouched. Players still join anonymously with
      //    zero prompts (Gate 10's invariant) — this gates would-be *referees*,
      //    not participants.
      //  - A pre-existing room whose `gmUid` is an unlinked anonymous uid keeps
      //    working: `update`/`delete` still only check `isGM`. Those GMs should
      //    be nudged to link via the R6.1 affordance, but nothing breaks if
      //    they don't.
      allow create: if signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.gmUid == request.auth.uid;
      allow read: if signedIn();
      // Only the GM may edit room-level fields (profileTemplate, difficulty/danger die, etc).
      allow update, delete: if isGM(roomId);

      match /players/{uid} {
        allow read: if signedIn();
        // A player manages their own seat doc; the GM can manage any seat.
        allow write: if signedIn() && (request.auth.uid == uid || isGM(roomId));
      }

      match /profiles/{seatId} {
        allow read: if signedIn();
        // Member-writable, not own-seat-only. Under group ownership a player
        // who owns a Group may act as EVERY character in it — open its sheet,
        // edit its fields, roll for it — so the old `request.auth.uid == seatId`
        // rule would have denied exactly the writes the model exists to allow.
        //
        // Expressing group ownership in the rules themselves is not free: a
        // group holds token ids, and a character is a *seat*, so the check is
        // "some group lists my uid AND holds a token whose ownerSeatId is this
        // seat" — two collection lookups per write, which rules cannot do
        // without denormalizing the owning seats onto every profile doc and
        // keeping that copy in sync. So group access is a client-side model
        // (`canSeatActAs`, `encounter/ownership.ts`) enforced by rendering a
        // sheet you may not act as read-only, and the rule falls back to this
        // room's standing trust model: any authenticated member may write
        // shared table state, exactly as `tokens`, `drawings`, `floorRegions`
        // and `log` already do. Token ownership never had server-side teeth
        // either (see the `sharedRoll/slots` note below), so this gives up no
        // guarantee that previously held.
        allow write: if isMember(roomId) || isGM(roomId);
      }

      match /tokens/{tokenId} {
        allow read: if signedIn();
        allow write: if isMember(roomId) || isGM(roomId);
      }

      // Groups roster (Phase 2): creation, membership, and the
      // [Map]/[Board]/[Active] toggles are GM controls (Encounter Screen
      // Spec §3, §8 — revealing/activating a group is the referee's call).
      // NOTE: read stays `signedIn()`, deliberately. Tightening it to
      // member-or-GM was tried and reverted: `RoomShell` subscribes to
      // groups/encounter/rolls/log on mount, which is *before* the visitor
      // clicks Join and gets their `players/{uid}` seat. A Firestore listener
      // denied at subscribe time never recovers, so every such client was left
      // with empty groups (making hidden tokens visible), no rolls, and no
      // encounter — permanently, even after joining. Closing this properly
      // means deferring those subscriptions until after join, which is a
      // separate change; the trust model here is "any authenticated member of
      // a room" and a roomId is the capability.
      match /groups/{groupId} {
        allow read: if signedIn();
        allow write: if isGM(roomId);
      }

      // Combat tracker (Encounter Screen Spec §10): GM-writable, all-readable
      // (see the groups note above on why read is not member-gated).
      match /encounter/{docId} {
        allow read: if signedIn();
        allow write: if isGM(roomId);
      }

      // Legacy flat annotation/symbol collections (pre-v10->v11, R17.3) — kept
      // ONLY so `ensureActiveMap` can read + delete a not-yet-migrated room's
      // data while adopting it into its first `maps/{mapId}` doc (see that
      // method's doc comment). No client ever writes NEW data at these flat
      // paths again. The cellular-only flat collections that used to live
      // here (floorChunks/walls/sightWalls/circleWalls/lights/fogChunks) were
      // deleted at the WI-D pure-rollout cutover along with the rest of the
      // cellular model (`docs/VectorMapSystem_Decisions.md`, D1).
      match /drawings/{strokeId} {
        allow read: if signedIn();
        allow write: if isMember(roomId) || isGM(roomId);
      }

      match /symbols/{symbolId} {
        allow read: if signedIn();
        allow write: if isMember(roomId) || isGM(roomId);
      }

      match /mapRooms/{mapRoomId} {
        allow read: if signedIn();
        allow write: if isMember(roomId) || isGM(roomId);
      }

      // Multiple full map builds per session (Master Plan v2, R17.3): the map
      // doc itself (background/grid/measure/gridSettings — create/rename/
      // delete/switch-active are all referee actions) plus its own map
      // subcollections, same trust model each collection had flat under
      // `rooms/{roomId}` before the v10->v11 migration moved them here.
      match /maps/{mapId} {
        allow read: if signedIn();
        allow create, update, delete: if isGM(roomId);

        match /drawings/{strokeId} {
          allow read: if signedIn();
          allow write: if isMember(roomId) || isGM(roomId);
        }

        // Symbol/label authoring (SPEC §2.2) — trust model, same as
        // tokens/drawings above.
        match /symbols/{symbolId} {
          allow read: if signedIn();
          allow write: if isMember(roomId) || isGM(roomId);
        }

        match /mapRooms/{mapRoomId} {
          allow read: if signedIn();
          allow write: if isMember(roomId) || isGM(roomId);
        }

        // Placed background images (SPEC-038 §1, v23) — one document per
        // image, each carrying its own lattice-unit rect. Same trust model as
        // every other map-scoped collection above: the existing per-room
        // member-write model extends here with no new boundary. Management is
        // referee-only in the UI (DEC-063), which is a UI gate in the same
        // sense the Maps manager's is, not a rules one.
        match /backgrounds/{backgroundId} {
          allow read: if signedIn();
          allow write: if isMember(roomId) || isGM(roomId);
        }

        // Painted hexes of a hex-crawl map (SPEC-030 §§2–3, v25) — one
        // document per hex, keyed by its own axial coordinate ("q,r"), holding
        // that hex's terrain and contents kinds.
        //
        // Member-or-GM write, and unlike `backgrounds` this one is NOT
        // referee-only in the UI either: SPEC-030 §3 is explicit that any seat
        // may select a hex and change its contents, which is the existing
        // per-room member write scope rather than a new boundary.
        match /hexTiles/{hexId} {
          allow read: if signedIn();
          allow write: if isMember(roomId) || isGM(roomId);
        }

        // Vector Map System (SPEC/DECISIONS in `docs/VectorMapSystem_Spec.md`) — the
        // ONLY map geometry model (WI-D pure-rollout cutover). Baked-union
        // floor regions, explicit/imported wall segments, and overlay doors.
        // Member-or-GM write, all-readable — same trust model the cellular
        // collections had before they were deleted.
        match /floorRegions/{regionId} {
          allow read: if signedIn();
          allow write: if isMember(roomId) || isGM(roomId);
        }

        match /walls/{wallId} {
          allow read: if signedIn();
          allow write: if isMember(roomId) || isGM(roomId);
        }

        match /doors/{doorId} {
          allow read: if signedIn();
          allow write: if isMember(roomId) || isGM(roomId);
        }

        // Fog of war's *revealed* geometry (SPEC §4). Same doc shape as
        // floorRegions, but the one map collection players may read and NOT
        // write — a player who could write here could reveal the map to
        // themselves.
        //
        // Read-for-all is deliberate and is the limit of what fog guarantees:
        // `floorRegions` is itself readable by every member, so fog is a
        // presentation guarantee (the client does not draw what the party
        // hasn't found), not a secrecy boundary against someone reading the
        // database directly. Hiding unexplored geometry server-side would mean
        // moving unrevealed floor behind `gmPrivate`, which is a different
        // design, not a rules tweak.
        match /fogRegions/{regionId} {
          allow read: if signedIn();
          allow write: if isGM(roomId);
        }
      }

      match /log/{entryId} {
        allow read: if signedIn();
        allow write: if isMember(roomId) || isGM(roomId);
      }

      match /rolls/{rollId} {
        allow read: if signedIn();
        allow write: if isMember(roomId) || isGM(roomId);
      }

      // Shared rolls (Master Plan v2, R3.6): the referee opens/resolves the
      // `current` staging doc; each seat's slot is its own doc, own-uid-or-GM
      // writable — same pattern as `players/{uid}` below, so a player can
      // never touch another seat's staged die.
      match /sharedRoll/{docId} {
        allow read: if signedIn();
        allow write: if isGM(roomId);

        // A slot id is either the writer's bare uid (an ordinary shared roll)
        // or `{uid}:{tokenId}` (Individual initiative, where one player may
        // stage several characters they own — see `characterSlotId`). Checking
        // only the uid *prefix* keeps this a pure string comparison: keying
        // slots by bare tokenId instead would force a `get()` on the token doc
        // to read `ownerSeatId`, costing a billed read on every slot write.
        // Token ownership itself is already trust-based (tokens are
        // member-writable), so the prefix check is the same guarantee the
        // bare-uid rule always gave.
        match /slots/{slotId} {
          allow read: if signedIn();
          allow write: if isGM(roomId)
            || (isMember(roomId) && slotId.split(':')[0] == request.auth.uid);
        }
      }

      // Saved dice macros (Plan §7 Phase 3): owning player or the GM only,
      // same pattern as profiles (§2.5) — `ownerUid` lives in the doc body
      // (unlike profiles, the doc id isn't the owner's uid). The GM may also
      // create a macro under another uid — needed for `.vttcamp` import
      // (Plan §5, §7 Phase 5) to restore a macro's original owner verbatim.
      match /macros/{macroId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          (request.resource.data.ownerUid == request.auth.uid || isGM(roomId));
        allow update, delete: if signedIn() &&
          (request.auth.uid == resource.data.ownerUid || isGM(roomId));
      }

      match /tables/{tableId} {
        allow read: if isMember(roomId) || isGM(roomId);
        allow write: if isGM(roomId);
      }

      // Assets activity's "By URL" saved-refs list (Master Plan v2, R7.2):
      // any member (or the GM, for `.vttcamp` import) may save/reuse a
      // pasted URL — same trust model as tokens/drawings above.
      match /assetRefs/{refId} {
        allow read: if signedIn();
        allow write: if isMember(roomId) || isGM(roomId);
      }

      // GM-ONLY. All hidden information (unrevealed fog, blind-drawer results,
      // hidden token notes, etc.) must live under this subtree.
      match /gmPrivate/{docId} {
        allow read, write: if isGM(roomId);
      }
    }
  }
}
