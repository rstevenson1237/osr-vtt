# Firebase web config (Plan §10.2) — not secret, safe to commit once real.
# Leave unset to run against the Emulator Suite with a demo project (Phase 0
# default — see src/lib/firebase/env.ts).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_DATABASE_URL=
# VITE_FIREBASE_APP_ID=

# Set to "false" once a real project + deploy target exist. Defaults to
# emulator mode (true) otherwise.
# VITE_USE_EMULATORS=true


# App Check (R24.2) — the reCAPTCHA v3 site key from the Firebase console.
# Leave UNSET to keep App Check off entirely: that is what lets zero-setup
# `pnpm dev`, the emulator suite and the Playwright e2e run against a project
# with no App Check registration. Setting it turns App Check on; dev and
# emulator runs then automatically use the debug provider.
# VITE_FIREBASE_APPCHECK_SITE_KEY=

# A pre-registered App Check debug token. Optional — with a site key set, dev
# and emulator runs already ask the SDK to mint one and log it. NEVER set this
# on a production build; a debug token bypasses attestation.
# VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
