# Real Firebase web config for the `osr-vtt` project (Plan §10.2 — public
# identifier, safe to commit). Used for `vite build --mode production`,
# i.e. the bundle deployed to Firebase Hosting. `pnpm dev` still defaults to
# the Emulator Suite via apps/web/.env.example / src/lib/firebase/env.ts.
VITE_FIREBASE_API_KEY=AIzaSyBzjpoSvZOyE6TBWolw1_ALJONywbdFmVk
VITE_FIREBASE_AUTH_DOMAIN=osr-vtt.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=osr-vtt
VITE_FIREBASE_DATABASE_URL=https://osr-vtt-default-rtdb.firebaseio.com
VITE_FIREBASE_APP_ID=1:35729552253:web:2ecd8751fc8b975d9fd214

VITE_USE_EMULATORS=false

# App Check (R24.2 / WI-25). Paste the reCAPTCHA v3 site key from the Firebase
# console here to turn App Check ON for the deployed bundle. Until then it
# stays off by construction — `loadFirebaseEnv` omits the appCheck block and
# `createFirebaseClient` never calls `initializeAppCheck`.
#
# Roll it out in the order R24.2 prescribes: register the app, set the provider
# to MONITORING mode, deploy with this key, watch the metrics through at least
# one full real session, and only then flip the console to enforcement.
# Enforcing before real clients ship the SDK locks them out.
VITE_FIREBASE_APPCHECK_SITE_KEY=6LfQW28tAAAAAKr21dnaSEAtYB6NKISuzhepNPJM
